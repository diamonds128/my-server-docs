---
const accents = [
  { id: 'purple', label: '紫', color: '#6750A4' },
  { id: 'blue', label: '蓝', color: '#005CBB' },
  { id: 'green', label: '绿', color: '#006E26' },
  { id: 'orange', label: '橙', color: '#B13E00' },
  { id: 'pink', label: '粉', color: '#B3266B' },
  { id: 'teal', label: '蓝绿', color: '#006A6A' },
  { id: 'red', label: '红', color: '#BA1A1A' },
  { id: 'yellow', label: '黄', color: '#8E7000' },
];
---
<starlight-accent-select class="md3-accent-select" data-accessible-label="主题色">
  <button type="button" class="md3-accent-select__button" aria-haspopup="menu" aria-expanded="false" aria-label="主题色: 紫" title="主题色: 紫">
    <span class="md3-accent-select__swatch" data-current-swatch style="background:#6750A4"></span>
    <span class="md3-accent-select__current">紫</span>
    <svg class="md3-accent-select__caret" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
  </button>
  <div class="md3-accent-select__menu" role="menu" hidden>
    {accents.map(a => (
      <button type="button" class="md3-accent-select__option" role="menuitemradio" aria-checked={a.id === 'purple' ? 'true' : 'false'} data-accent-value={a.id}>
        <span class="md3-accent-select__swatch" style={`background:${a.color}`}></span>
        <span>{a.label}</span>
        <svg class="md3-accent-select__check" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>
      </button>
    ))}
  </div>
</starlight-accent-select>

<script>
  const storageKey = 'starlight-accent';
  const labels = { purple: '紫', blue: '蓝', green: '绿', orange: '橙', pink: '粉', teal: '蓝绿', red: '红', yellow: '黄' };
  const load = () => { try { return localStorage.getItem(storageKey) || 'purple'; } catch { return 'purple'; } };

  // 自定义元素：每个实例各自绑定事件，支持同时出现在桌面顶部栏与移动端菜单
  class StarlightAccentSelect extends HTMLElement {
    connectedCallback() {
      this._btn = this.querySelector('.md3-accent-select__button');
      this._menu = this.querySelector('.md3-accent-select__menu');
      this._current = this.querySelector('.md3-accent-select__current');
      this._swatch = this.querySelector('[data-current-swatch]');
      this._options = [...this.querySelectorAll('.md3-accent-select__option')];
      this._byId = Object.fromEntries(this._options.map(o => [o.dataset.accentValue, o]));
      this._closeTimer = 0;

      this.apply(load());
      this.sync();
      this._bind();
    }

    disconnectedCallback() {
      document.removeEventListener('pointerdown', this._onDocPointerDown);
      clearTimeout(this._closeTimer);
    }

    apply(id) {
      document.documentElement.dataset.accent = id;
      try { localStorage.setItem(storageKey, id); } catch {}
    }

    sync() {
      const id = document.documentElement.dataset.accent;
      const cur = this._byId[id];
      this._options.forEach(o => o.setAttribute('aria-checked', o === cur ? 'true' : 'false'));
      if (cur && this._btn && this._current && this._swatch) {
        this._btn.setAttribute('aria-label', `主题色: ${labels[id]}`);
        this._btn.setAttribute('title', `主题色: ${labels[id]}`);
        this._current.textContent = labels[id];
        this._swatch.style.background = cur.querySelector('.md3-accent-select__swatch').style.background;
      }
    }

    closeMenu() {
      if (!this._btn || !this._menu) return;
      this._btn.setAttribute('aria-expanded', 'false');
      clearTimeout(this._closeTimer);
      this._menu.removeEventListener('transitionend', this._onTransitionEnd);

      if (this._menu.hidden || matchMedia('(prefers-reduced-motion: reduce)').matches) {
        this._menu.hidden = true;
        this._menu.removeAttribute('data-md3-menu-state');
        return;
      }

      this._menu.dataset.md3MenuState = 'closing';
      this._onTransitionEnd = (event) => {
        if (event.target === this._menu && event.propertyName === 'transform') {
          this._menu.hidden = true;
          this._menu.removeAttribute('data-md3-menu-state');
          clearTimeout(this._closeTimer);
        }
      };
      this._menu.addEventListener('transitionend', this._onTransitionEnd);
      this._closeTimer = window.setTimeout(() => {
        this._menu.hidden = true;
        this._menu.removeAttribute('data-md3-menu-state');
        this._menu.removeEventListener('transitionend', this._onTransitionEnd);
      }, 260);
    }

    openMenu() {
      if (!this._btn || !this._menu) return;
      clearTimeout(this._closeTimer);
      this._btn.setAttribute('aria-expanded', 'true');
      this._menu.hidden = false;
      this._menu.removeAttribute('data-md3-menu-state');
      const selected = this.querySelector('.md3-accent-select__option[aria-checked="true"]');
      selected?.focus();
      this.sync();
    }

    _bind() {
      this._btn?.addEventListener('click', () => {
        const open = this._btn.getAttribute('aria-expanded') === 'true';
        open ? this.closeMenu() : this.openMenu();
      });
      this._options.forEach(o => o.addEventListener('click', () => {
        this.apply(o.dataset.accentValue);
        this.sync();
        this.closeMenu();
        this._btn?.focus();
      }));
      this.addEventListener('keydown', (e) => {
        if (!(e instanceof KeyboardEvent)) return;
        const open = this._btn?.getAttribute('aria-expanded') === 'true';
        if (e.key === 'Escape') {
          e.preventDefault();
          this.closeMenu();
          this._btn?.focus();
          return;
        }
        if (!open && ['ArrowDown', 'Enter', ' '].includes(e.key)) {
          e.preventDefault();
          this.openMenu();
          return;
        }
        if (!open || !['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(e.key)) return;
        e.preventDefault();
        const currentIndex = Math.max(0, this._options.indexOf(document.activeElement));
        const nextIndex =
          e.key === 'Home' ? 0
          : e.key === 'End' ? this._options.length - 1
          : e.key === 'ArrowDown' ? (currentIndex + 1) % this._options.length
          : (currentIndex - 1 + this._options.length) % this._options.length;
        this._options[nextIndex]?.focus();
      });
      this._onDocPointerDown = (e) => {
        if (e.target instanceof Node && !this.contains(e.target)) this.closeMenu();
      };
      document.addEventListener('pointerdown', this._onDocPointerDown);
    }
  }
  customElements.define('starlight-accent-select', StarlightAccentSelect);
</script>

<style>
  starlight-accent-select {
    position: relative;
    display: inline-flex;
    min-width: 0;
  }
  .md3-accent-select__button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0.5rem;
    box-sizing: border-box;
    min-inline-size: 4.5rem;
    block-size: 2.5rem;
    min-block-size: 2.5rem;
    border: none;
    border-radius: var(--md-sys-shape-full);
    background-color: var(--md3-comp-header-control-container-color);
    color: var(--md3-comp-header-control-label-color);
    cursor: pointer;
    font-size: var(--md-sys-typescale-label-large-size);
    font-weight: var(--md-sys-typescale-label-large-weight);
    padding-block: 0;
    padding-inline: 0.75rem 0.875rem;
  }
  .md3-accent-select__button:hover {
    background-color: var(--md3-comp-header-control-hover-container-color);
    color: var(--md3-comp-header-control-hover-label-color);
  }
  .md3-accent-select__button:focus-visible {
    background-color: var(--md3-comp-header-control-focus-container-color);
    color: var(--md3-comp-header-control-focus-label-color);
    outline: 2px solid var(--md3-comp-header-control-focus-outline-color);
    outline-offset: 2px;
  }
  .md3-accent-select__button[aria-expanded='true'] {
    background-color: var(--md-sys-color-secondary-container);
    color: var(--md-sys-color-on-secondary-container);
  }
  .md3-accent-select__swatch {
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    flex: 0 0 auto;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.08);
  }
  .md3-accent-select__caret {
    margin-inline-start: 0.125rem;
    color: currentColor;
    opacity: 0.84;
  }
  .md3-accent-select__button[aria-expanded='true'] .md3-accent-select__caret {
    transform: rotate(180deg);
  }
  .md3-accent-select__menu {
    position: absolute;
    z-index: calc(var(--sl-z-index-navbar) + 1);
    inset-block-start: calc(100% + 0.5rem);
    inset-inline-end: 0;
    box-sizing: border-box;
    inline-size: max-content;
    min-inline-size: 8.5rem;
    padding-block: 0.5rem;
    padding-inline: 0;
    border: 1px solid transparent;
    border-radius: var(--md3-comp-menu-shape);
    background-color: var(--md3-comp-menu-container-color);
    box-shadow: var(--md3-comp-menu-elevation);
    color: var(--md3-comp-menu-label-color);
    transform-origin: top right;
  }
  .md3-accent-select__menu[hidden] {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .md3-accent-select__menu {
      opacity: 1;
      transform: translateY(0) scale(1);
      transition:
        opacity var(--md-sys-motion-duration-medium1)
          var(--md-sys-motion-easing-emphasized-decelerate),
        transform var(--md-sys-motion-duration-medium1)
          var(--md-sys-motion-easing-emphasized-decelerate),
        background-color var(--md3-motion-duration-state) var(--md-sys-motion-easing-standard),
        border-color var(--md3-motion-duration-state) var(--md-sys-motion-easing-standard),
        box-shadow var(--md3-motion-duration-control) var(--md-sys-motion-easing-standard),
        display var(--md-sys-motion-duration-medium1) allow-discrete;
      transition-behavior: allow-discrete;
      will-change: opacity, transform;
    }

    .md3-accent-select__menu[hidden],
    .md3-accent-select__menu[data-md3-menu-state='closing'] {
      opacity: 0;
      transform: translateY(-0.1875rem) scale(0.88);
    }

    .md3-accent-select__menu[data-md3-menu-state='closing'] {
      pointer-events: none;
      transition:
        opacity var(--md-sys-motion-duration-short3)
          var(--md-sys-motion-easing-emphasized-accelerate),
        transform var(--md-sys-motion-duration-short3)
          var(--md-sys-motion-easing-emphasized-accelerate),
        background-color var(--md3-motion-duration-state) var(--md-sys-motion-easing-standard),
        border-color var(--md3-motion-duration-state) var(--md-sys-motion-easing-standard),
        box-shadow var(--md3-motion-duration-control) var(--md-sys-motion-easing-standard);
    }

    @starting-style {
      .md3-accent-select__menu:not([hidden]) {
        opacity: 0;
        transform: translateY(-0.1875rem) scale(0.88);
      }
    }
  }
  .md3-accent-select__option {
    position: relative;
    display: grid;
    grid-template-columns: 1.25rem minmax(0, 1fr) 1rem;
    align-items: center;
    gap: 0.75rem;
    inline-size: 100%;
    min-block-size: 2.75rem;
    border: 0;
    border-radius: 0;
    background-color: transparent;
    color: inherit;
    cursor: pointer;
    font-size: var(--md-sys-typescale-label-large-size);
    font-weight: 400;
    text-align: start;
    white-space: nowrap;
    padding-block: 0;
    padding-inline: 1rem;
  }
  .md3-accent-select__option:hover {
    background-color: var(--md3-comp-menu-item-hover-container-color);
    color: var(--md3-comp-menu-item-hover-label-color);
  }
  .md3-accent-select__option:focus-visible {
    background-color: var(--md3-comp-menu-item-focus-container-color);
    color: var(--md3-comp-menu-item-focus-label-color);
    outline: 0;
  }
  .md3-accent-select__option[aria-checked='true'] {
    background-color: var(--md3-comp-menu-item-selected-container-color);
    color: var(--md3-comp-menu-item-selected-label-color);
    font-weight: 500;
  }
  .md3-accent-select__check {
    justify-self: end;
    opacity: 0;
  }
  .md3-accent-select__option[aria-checked='true'] .md3-accent-select__check {
    opacity: 1;
  }
  @media (prefers-reduced-motion: no-preference) {
    .md3-accent-select__caret {
      transition: transform var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-emphasized);
    }
  }
</style>
