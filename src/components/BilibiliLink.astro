---
// B 站个人空间链接（浅色模式下与其余社交图标风格一致）
const href = 'https://space.bilibili.com/492427009';
const label = 'B 站个人空间';
---

<a class="bilibili-link" href={href} rel="me" target="_blank" aria-label={label} title={label}>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M8.5 3.2 10 5" />
    <path d="M15.5 3.2 14 5" />
    <rect x="3.2" y="5.4" width="17.6" height="13.4" rx="3" />
    <circle cx="9.2" cy="12" r="1.9" fill="currentColor" stroke="none" />
    <circle cx="14.8" cy="12" r="1.9" fill="currentColor" stroke="none" />
  </svg>
</a>

<style>
	@layer starlight.core {
		.bilibili-link {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			color: inherit;
			text-decoration: none;
		}
		.bilibili-link svg {
			inline-size: var(--sl-icon-size, 1.25rem);
			block-size: var(--sl-icon-size, 1.25rem);
		}
		.bilibili-link:hover {
			color: var(--md-sys-color-primary, var(--sl-color-gray-1));
		}
	}
</style>
