---
// 页脚「查看源码」入口：按文件扩展名选择对应的源码路由。
// 站点里既有 .md 也有 .mdx，还有 index.mdx 这类首页，所以不能一律指向 raw/。
// 首页、404 页不显示：首页是 splash 模板，404 是兜底页，没有对外公开的源码入口。
import DefaultFooter from '@astrojs/starlight/components/Footer.astro';

const pathname = Astro.url.pathname;
const isHome = pathname === '/my-server-docs/' || pathname === '/my-server-docs';
const is404 = pathname === '/my-server-docs/404' || pathname === '/my-server-docs/404.html';

const entryId = Astro.locals.starlightRoute?.entry?.id;
const filePath = Astro.locals.starlightRoute?.entry?.filePath ?? '';
const ext = filePath.endsWith('.mdx') ? 'mdx' : 'md';

// Markdown 走 raw 纯文本路由；MDX 走独立页面，避免把 JSX 当 Markdown 渲染
// 统计页是 .astro 页面，没有对应的文档源码文件，直接指向 stats.astro 本身
const isStats = pathname.replace(/\/$/, '') === '/my-server-docs/stats';
const sourceUrl = isStats
  ? `${import.meta.env.BASE_URL}source/stats/`
  : entryId && entryId !== '404'
    ? ext === 'mdx'
      ? `${import.meta.env.BASE_URL}source/${entryId}/`
      : `${import.meta.env.BASE_URL}raw/${entryId}/`
    : undefined;
const sourceLabel = isStats
  ? '查看页面源码'
  : ext === 'mdx'
    ? '查看 MDX 源码'
    : '查看 Markdown 源码';

// 图标：Material Symbols Outlined（960 网格，viewBox="0 -960 960 960"），
// 与侧边栏分组图标同一套，均为空心轮廓字重。
// 注意：StarlightPage 渲染的页面没有 starlightRoute.entry，拿不到文档对应的源码文件，
// 因此这些页面不挂「查看源码」入口。
const ICONS = {
  edit: 'M200-200h57l391-391-57-57-391 391v57Zm-80 80v-170l528-527q12-11 26.5-17t30.5-6q16 0 31 6t26 18l55 56q12 11 17.5 26t5.5 30q0 16-5.5 30.5T817-647L290-120H120Zm640-584-56-56 56 56Zm-141 85-28-29 57 57-29-28Z',
  code: 'M320-240 80-480l240-240 57 57-184 184 183 183-56 56Zm320 0-57-57 184-184-183-183 56-56 240 240-240 240Z',
};
const VIEW_BOX = '0 -960 960 960';
const script = `(() => {
  const meta = document.querySelector('footer .meta');
  const editLink = meta && meta.querySelector('a[href*="/edit/"]');
  if (!meta || meta.querySelector('[data-raw-source]')) return;
  const ICONS = ${JSON.stringify(ICONS)};
  const VIEW_BOX = ${JSON.stringify(VIEW_BOX)};
  const makeIcon = (path) => {
    const NS = 'http://www.w3.org/2000/svg';
    const el = document.createElementNS(NS, 'svg');
    el.setAttribute('class', 'icon');
    el.setAttribute('aria-hidden', 'true');
    el.setAttribute('width', '16');
    el.setAttribute('height', '16');
    el.setAttribute('viewBox', VIEW_BOX);
    el.setAttribute('fill', 'currentColor');
    const p = document.createElementNS(NS, 'path');
    p.setAttribute('d', path);
    el.append(p);
    return el;
  };
  if (editLink) {
    const old = editLink.querySelector('svg');
    if (old) old.replaceWith(makeIcon(ICONS.edit));
  }
  const link = document.createElement('a');
  link.href = ${JSON.stringify(sourceUrl ?? '')};
  link.dataset.rawSource = '';
  link.className = 'sl-flex print:hidden raw-source-link';
  link.append(makeIcon(ICONS.code), ${JSON.stringify(sourceLabel)});
  // 有「编辑本页」时插到它后面；没有（如统计页）就单独成组
  if (editLink) editLink.after(link);
  const group = document.createElement('div');
  group.className = 'sl-flex meta-actions';
  meta.prepend(group);
  if (editLink) group.append(editLink);
  group.append(link);
})();`;
---

<!-- 始终保留默认 Footer -->
<DefaultFooter />

<!--
  默认 Footer 的 .meta 用 space-between 排布：编辑本页靠左、最后更新靠右。
  这里把「查看源码」插到编辑本页右侧，并让两者成组一起靠左，
  最后更新仍保持靠右。两个链接的图标统一替换为 Material Symbols Outlined。
-->
{sourceUrl && (
  <script is:inline set:html={script} />
)}

<!-- 仅当不是首页、也不是 404 页面时，才显示自定义版权声明 -->
{!isHome && !is404 && (
  <div class="custom-footer">
    <p>
      除另有声明，本文档根据{' '}
      <a
        href="https://creativecommons.org/licenses/by-nc-sa/4.0/"
        target="_blank"
        rel="noopener noreferrer"
      >
        CC BY-NC-SA 4.0
      </a>{' '}
      协议共享
    </p>
  </div>
)}

<style>
  .custom-footer {
    text-align: center;
    padding: 1rem 0;
    font-size: var(--md-sys-typescale-body-medium-size);
    margin-top: 2rem;
    color: var(--md-sys-color-on-surface-variant);
  }
  .custom-footer a {
    color: var(--md-sys-color-primary);
    text-decoration: none;
  }
  .custom-footer a:hover {
    text-decoration: underline;
  }
</style>

<style is:global>
  @layer starlight.core {
    footer .meta-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.75rem 1.5rem;
      margin-inline-end: auto !important;
    }
    footer .meta-actions > a {
      display: inline-flex;
      gap: 0.5rem;
      align-items: center;
      text-decoration: none;
      color: var(--sl-color-gray-3);
    }
    footer .meta-actions > a:hover {
      color: var(--sl-color-white);
    }
    footer .meta-actions > a .icon {
      flex-shrink: 0;
      width: 1.2em;
      height: 1.2em;
    }
  }
</style>
