---
import AccentSwitcher from '../components/AccentSwitcher.astro';
import BilibiliLink from '../components/BilibiliLink.astro';
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
---

<div class="mobile-preferences sl-flex">
	<div class="social-icons">
		<SocialIcons />
		<BilibiliLink />
	</div>
	<div class="preference-controls">
		<AccentSwitcher />
		<ThemeSelect />
		<LanguageSelect />
	</div>
</div>

<style>
	@layer starlight.core {
		.social-icons {
			display: flex;
			gap: 1rem;
			align-items: center;
			padding-block: 1rem;
		}
		.social-icons:empty {
			display: none;
		}
		.preference-controls {
			display: flex;
			align-items: center;
			gap: 0.5rem;
		}
		.mobile-preferences {
			justify-content: flex-start;
			flex-wrap: wrap;
			border-top: 1px solid var(--md-sys-color-outline-variant);
			column-gap: 1rem;
			padding: 0.5rem 0;
		}
	}
</style>